{
	"extends": "./TypeScript/tsconfig.generated.json",
	"include": [
		"./UI/Source/**/*",
		"./Admin/Source/**/*",
		"./Email/Source/**/*",
		"./TypeScript/**/*"
	],
	"compilerOptions": {
		"target": "es2022",
		"jsx": "react-jsx",
		"moduleResolution": "bundler",
		"lib": [ "DOM", "DOM.Iterable", "es2022" ],
		"types": [ "react", "react-dom" ],
		"strict": true,
		"skipLibCheck": true,
		"noImplicitAny": true
	}
}